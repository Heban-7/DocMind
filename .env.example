# DocMind environment configuration (copy to .env and fill in)
# ==============================================================================

# --- Authentication (required) -----------------------------------------------
# The API refuses to start without a random secret of at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# JWT_EXPIRY_HOURS=24

# --- Database (required) ------------------------------------------------------
# Postgres 17 with pgvector. For local development:
#   docker compose -f docker-compose.dev.yml up -d db
# The API applies migrations at start-up (DOCMIND_AUTO_MIGRATE=1, the default).
# DOCMIND_DATABASE_URL=postgresql://docmind:docmind-dev-only@localhost:5433/docmind
# Optional separate owner connection for migrations (defaults to the URL above):
# DOCMIND_DATABASE_ADMIN_URL=
# DOCMIND_DB_POOL_SIZE=8
# DOCMIND_AUTO_MIGRATE=1

# Stored PDFs and document models (default: ./.refinery/storage, never committed)
# DOCMIND_STORAGE_DIR=.refinery/storage
# DOCMIND_MAX_UPLOAD_MB=50

# You only need ONE provider key to enable the LLM/VLM features. OpenRouter is
# the easiest ("one key, any model"); direct providers are cheaper/faster.

# --- LLM provider API keys (set at least one) --------------------------------
# OpenRouter: single key, swap to almost any model by name. Recommended default.
OPENROUTER_API_KEY=
# Direct providers:
OPENAI_API_KEY=
GEMINI_API_KEY=
# (GOOGLE_API_KEY is also accepted for Gemini.)
GROQ_API_KEY=

# --- Model selection ---------------------------------------------------------
# Force a provider (optional): openrouter | openai | gemini | groq
# If unset, the system auto-detects by whichever key is present.
LLM_PROVIDER=
# Force a model by friendly name (see rubric/models.yaml) or a raw slug, e.g.:
#   gemini-flash | gpt-4o-mini | or-gemini-flash | google/gemini-2.0-flash-001
LLM_MODEL=
# Separate (cheap) model for text tasks like domain classification.
# Defaults to the registry's `defaults.text` (gemini-flash) when unset.
LLM_TEXT_MODEL=

# Path to the model registry (optional override).
# DOCMIND_MODEL_REGISTRY=rubric/models.yaml

# --- Embeddings + retrieval (OpenAI) ------------------------------------------
# Requires OPENAI_API_KEY above. Vectors are stored in Postgres (pgvector) in a
# vector(1536) column, so keep the default model and leave DOCMIND_EMBEDDING_DIMS
# unset unless you also change the migration.
# DOCMIND_EMBEDDING_PROVIDER=openai
# DOCMIND_EMBEDDING_MODEL=text-embedding-3-small
# DOCMIND_EMBEDDING_BATCH=64

# --- LangSmith observability (STEP 3) ----------------------------------------
# Create an API key at https://smith.langchain.com -> Settings -> API Keys
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=docmind

# --- Ingest worker ------------------------------------------------------------
# Uploads are queued; a worker process reads them. For local development the
# API starts one itself (1). In production run `python -m src.jobs.worker`
# as its own process and set this to 0.
# DOCMIND_EMBEDDED_WORKER=1
# Largest PDF accepted, in pages
# DOCMIND_MAX_PAGES=500
# Load the extraction models when the worker starts (1) or on first use (0)
# DOCMIND_WORKER_WARMUP=1
# Retries: lease length while a worker holds a job, and the base retry delay
# DOCMIND_JOB_LEASE_SECONDS=300
# DOCMIND_JOB_RETRY_SECONDS=30

# --- Extraction (optional overrides) -------------------------------------------
# Compute device: auto | cuda | mps | cpu   (auto picks GPU when available)
# DOCMIND_DEVICE=auto
# Parallel lanes (auto: one per CPU core, up to 4; one on a GPU) and torch
# threads per lane (auto: cores / lanes)
# DOCMIND_EXTRACT_LANES=auto
# DOCMIND_NUM_THREADS=
# Pages per Docling call (default 4 on CPU, 8 on GPU)
# DOCMIND_PAGE_BATCH=
# TableFormer: auto (accurate on GPU, fast on CPU) | fast | accurate
# DOCMIND_V2_TABLE_MODE=auto

# --- OCR (Tesseract, Amharic-aware) ----------------------------------------------
# Scanned pages need the Tesseract CLI with the amh and eng language data.
# DOCMIND_OCR_LANGS=amh+eng
